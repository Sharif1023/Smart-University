export const bands = [
  [80, "A+", 4],
  [75, "A", 3.75],
  [70, "A-", 3.5],
  [65, "B+", 3.25],
  [60, "B", 3],
  [55, "B-", 2.75],
  [50, "C+", 2.5],
  [45, "C", 2.25],
  [40, "D", 2],
  [0, "F", 0],
];
export async function mapLegacy(db) {
  const q = async (sql, ...args) => (await db.execute(sql, args))[0];
  await q("INSERT INTO program_rules(program) SELECT id FROM programs ON CONFLICT DO NOTHING");
  for (const [min, label, gp] of bands)
    await q(
      "INSERT INTO grade_bands(program,minimum,letter,points) SELECT id,?,?,? FROM programs p WHERE NOT EXISTS(SELECT 1 FROM grade_bands g WHERE g.program=p.id AND g.minimum=?) ON CONFLICT DO NOTHING",
      min,
      label,
      gp,
      min,
    );
  await q(
    "INSERT INTO class_sessions(offering,day,status) SELECT DISTINCT r.offering,a.day,'Held' FROM attendance a JOIN registrations r ON r.id=a.reg WHERE TRUE ON CONFLICT DO NOTHING",
  );
  await q(
    "INSERT INTO receipt_details(receipt,state,method) SELECT id,'Valid','Recorded' FROM receipts ON CONFLICT DO NOTHING",
  );
  await q(
    "INSERT INTO invoice_items(invoice,label,amount) SELECT i.id,i.label,i.amount FROM invoices i WHERE NOT EXISTS(SELECT 1 FROM invoice_items e WHERE e.invoice=i.id)",
  );
  await q(
    "INSERT INTO section_details(offering,status) SELECT id,'Active' FROM offerings ON CONFLICT DO NOTHING",
  );
  const books = await q("SELECT id,copies FROM books");
  for (const b of books) {
    for (let i = 1; i <= b.copies; i++)
      await q(
        "INSERT INTO book_copies(book,accession) VALUES(?,?) ON CONFLICT DO NOTHING",
        b.id,
        "BK-" + b.id + "-" + i,
      );
    const old = await q(
      "SELECT l.* FROM loans l LEFT JOIN loan_copies lc ON lc.loan=l.id WHERE l.book=? AND lc.id IS NULL ORDER BY l.issued,l.id",
      b.id,
    );
    for (const l of old) {
      const [c] = await q(
        "SELECT c.id FROM book_copies c WHERE c.book=? AND NOT EXISTS(SELECT 1 FROM loan_copies lc JOIN loans x ON x.id=lc.loan WHERE lc.copy_id=c.id AND (x.returned IS NULL OR x.returned>?) AND (?AND (?::date IS NULL OR x.issued<?)) ORDER BY c.id LIMIT 1::date IS NULL OR x.issued<?)) ORDER BY c.id LIMIT 1",
        b.id,
        l.issued,
        l.returned,
        l.returned,
      );
      if (!c)
        throw Error("Historical loans exceed physical copies for book " + b.id);
      await q("INSERT INTO loan_copies(loan,copy_id) VALUES(?,?)", l.id, c.id);
    }
  }
  await q(
    "INSERT INTO grade_publications(reg,letter,points,mark,state) SELECT g.reg,b.letter,b.points,g.mark,'Locked' FROM (SELECT r.reg,o.program,ROUND((r.assessment*COALESCE(p.coursework_weight,40)+r.exam*(100-COALESCE(p.coursework_weight,40)))/100,2) mark FROM results r JOIN registrations e ON e.id=r.reg JOIN offerings o ON o.id=e.offering LEFT JOIN marking_policy p ON p.offering=o.id WHERE r.published=1) g JOIN grade_bands b ON b.program=g.program AND b.minimum=(SELECT MAX(k.minimum) FROM grade_bands k WHERE k.program=g.program AND k.minimum<=g.mark) WHERE TRUE ON CONFLICT DO NOTHING",
  );
}
